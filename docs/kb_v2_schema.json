{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knowledge Base v2.0 Schema",
  "description": "Android-compatible knowledge base format produced by the PaddleModels v2 pipeline.",
  "type": "object",
  "required": ["fileMetadata", "entries"],
  "properties": {
    "fileMetadata": {
      "type": "object",
      "required": ["schemaVersion", "fileId", "entriesCount", "docSha256"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "2.0" },
        "fileId": { "type": "string" },
        "fileName": { "type": "string" },
        "source": { "type": "string" },
        "importTimestamp": { "type": ["string", "null"] },
        "entriesCount": { "type": "integer" },
        "imagesCount": { "type": "integer" },
        "docSha256": { "type": "string" },
        "pageSizes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "coordinateUnit": { "type": "string", "enum": ["pt", "px"] },
        "buildTool": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entryId", "jobTitle", "contentMarkdown", "pageNumber", "position", "kind", "blocks"],
        "properties": {
          "entryId": { "type": "string" },
          "unitName": { "type": "string" },
          "jobTitle": { "type": "string" },
          "contentMarkdown": { "type": "string" },
          "contentNormalized": { "type": "string" },
          "pageNumber": { "type": "integer" },
          "position": { "type": "integer" },
          "kind": { "type": "string", "enum": ["text", "table"] },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "pageNumber", "bbox"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string", "enum": ["code", "table", "image"] },
                "language": { "type": "string" },
                "code": { "type": "string" },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "imageUri": { "type": "string" },
                "pageNumber": { "type": "integer" },
                "semanticRole": { "type": "string" },
                "bbox": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["x", "y", "w", "h"],
                      "properties": {
                        "x": { "type": "number" },
                        "y": { "type": "number" },
                        "w": { "type": "number" },
                        "h": { "type": "number" }
                      }
                    },
                    {
                      "type": "array",
                      "items": { "type": "number" },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
