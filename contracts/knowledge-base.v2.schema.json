{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeBaseV2",
  "type": "object",
  "properties": {
    "document_id": { "type": "string" },
    "schema_version": { "type": "string", "enum": ["2.0"] },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_number": { "type": "integer" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "text": { "type": "string" },
                "bbox": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "w": { "type": "number" },
                    "h": { "type": "number" }
                  },
                  "required": ["x", "y", "w", "h"]
                },
                "page_number": { "type": "integer" },
                "reading_order": { "type": "integer" },
                "confidence": { "type": "number" },
                "source": { "type": "string" },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "figureTextAssociations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["kind", "blockId", "text", "source", "method"],
                        "properties": {
                          "kind": { "type": "string", "enum": ["caption", "legend"] },
                          "blockId": { "type": "string" },
                          "text": { "type": "string" },
                          "source": { "type": "string" },
                          "method": { "type": "string" }
                        },
                        "additionalProperties": true
                      }
                    },
                    "figureLabels": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["rawLabel", "normalizedLabel", "source", "method", "confidence"],
                        "properties": {
                          "rawLabel": { "type": "string" },
                          "normalizedLabel": { "type": "string", "minLength": 1 },
                          "source": { "type": "string", "enum": ["native", "ocr"] },
                          "method": { "type": "string" },
                          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                        },
                        "additionalProperties": false
                      }
                    },
                    "figureReferences": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["referenceId", "rawLabel", "normalizedLabel", "status", "method"],
                        "properties": {
                          "referenceId": { "type": "string", "minLength": 1 },
                          "rawLabel": { "type": "string" },
                          "normalizedLabel": { "type": "string", "minLength": 1 },
                          "status": {
                            "type": "string",
                            "enum": ["resolved", "unresolved", "ambiguous"]
                          },
                          "method": { "type": "string" },
                          "targetFigureId": { "type": "string" },
                          "targetPageNumber": { "type": "integer" },
                          "pageDelta": { "type": "integer" },
                          "reason": { "type": "string" }
                        },
                        "additionalProperties": false,
                        "allOf": [
                          {
                            "if": { "properties": { "status": { "const": "resolved" } } },
                            "then": { "required": ["targetFigureId", "targetPageNumber", "pageDelta"] }
                          },
                          {
                            "if": {
                              "properties": {
                                "status": { "enum": ["unresolved", "ambiguous"] }
                              }
                            },
                            "then": { "required": ["reason"] }
                          }
                        ]
                      }
                    },
                    "referencedBy": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "referenceId",
                          "sourceBlockId",
                          "sourcePageNumber",
                          "rawLabel",
                          "normalizedLabel"
                        ],
                        "properties": {
                          "referenceId": { "type": "string" },
                          "sourceBlockId": { "type": "string" },
                          "sourcePageNumber": { "type": "integer" },
                          "rawLabel": { "type": "string" },
                          "normalizedLabel": { "type": "string" }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": true
                }
              },
              "required": ["id", "type", "text", "bbox", "page_number", "reading_order"]
            }
          },
          "tables": { "type": "array" },
          "images": { "type": "array" },
          "method": { "type": "string" },
          "rotation": { "type": "integer" }
        },
        "required": ["page_number", "width", "height", "blocks"]
      }
    },
    "metadata": { "type": "object" },
    "sha256": { "type": "string" }
  },
  "required": ["document_id", "schema_version", "pages"]
}
