{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeBase V2.0",
  "type": "object",
  "required": ["fileMetadata", "entries"],
  "properties": {
    "fileMetadata": {
      "type": "object",
      "required": ["schemaVersion", "fileId", "docSha256"],
      "properties": {
        "schemaVersion": { "type": "string", "enum": ["2.0"] },
        "fileId": { "type": "string" },
        "fileName": { "type": "string" },
        "source": { "type": "string" },
        "importTimestamp": { "type": ["string", "null"] },
        "entriesCount": { "type": "integer" },
        "imagesCount": { "type": "integer" },
        "docSha256": { "type": "string" },
        "pageSizes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "coordinateUnit": { "type": "string" },
        "buildTool": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entryId", "jobTitle", "blocks"],
        "properties": {
          "entryId": { "type": "string" },
          "unitName": { "type": "string" },
          "jobTitle": { "type": "string" },
          "contentMarkdown": { "type": "string" },
          "contentNormalized": { "type": "string" },
          "pageNumber": { "type": "integer" },
          "position": { "type": "integer" },
          "kind": { "type": "string", "enum": ["text", "table", "figure"] },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "bbox"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "text": { "type": ["string", "null"] },
                "code": { "type": ["string", "null"] },
                "bbox": {
                  "type": "object",
                  "required": ["left", "top", "right", "bottom"],
                  "properties": {
                    "left": { "type": "number" },
                    "top": { "type": "number" },
                    "right": { "type": "number" },
                    "bottom": { "type": "number" },
                    "width": { "type": "number" },
                    "height": { "type": "number" }
                  }
                },
                "pageNumber": { "type": "integer" },
                "semanticRole": { "type": "string" },
                "searchable": { "type": "boolean" },
                "structureStatus": {
                  "type": "string",
                  "enum": ["structured", "image_only"]
                },
                "imageUri": { "type": "string" },
                "assetSource": { "type": "string", "enum": ["embedded", "page_crop"] },
                "assetStatus": { "type": "string", "enum": ["ready", "missing"] },
                "contentSha256": { "type": "string" },
                "mimeType": { "type": "string" },
                "pixelWidth": { "type": "integer", "minimum": 0 },
                "pixelHeight": { "type": "integer", "minimum": 0 },
                "figureTextAssociations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "blockId", "text", "source", "method"],
                    "properties": {
                      "kind": { "type": "string", "enum": ["caption", "legend"] },
                      "blockId": { "type": "string" },
                      "text": { "type": "string" },
                      "source": { "type": "string" },
                      "method": { "type": "string" }
                    }
                  }
                },
                "figureLabels": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["rawLabel", "normalizedLabel", "source", "method", "confidence"],
                    "properties": {
                      "rawLabel": { "type": "string" },
                      "normalizedLabel": { "type": "string", "minLength": 1 },
                      "source": { "type": "string", "enum": ["native", "ocr"] },
                      "method": { "type": "string" },
                      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "additionalProperties": false
                  }
                },
                "figureReferences": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["referenceId", "rawLabel", "normalizedLabel", "status", "method"],
                    "properties": {
                      "referenceId": { "type": "string", "minLength": 1 },
                      "rawLabel": { "type": "string" },
                      "normalizedLabel": { "type": "string", "minLength": 1 },
                      "status": {
                        "type": "string",
                        "enum": ["resolved", "unresolved", "ambiguous"]
                      },
                      "method": { "type": "string" },
                      "targetFigureId": { "type": "string" },
                      "targetPageNumber": { "type": "integer" },
                      "pageDelta": { "type": "integer" },
                      "reason": { "type": "string" }
                    },
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": { "properties": { "status": { "const": "resolved" } } },
                        "then": { "required": ["targetFigureId", "targetPageNumber", "pageDelta"] }
                      },
                      {
                        "if": {
                          "properties": {
                            "status": { "enum": ["unresolved", "ambiguous"] }
                          }
                        },
                        "then": { "required": ["reason"] }
                      }
                    ]
                  }
                },
                "referencedBy": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "referenceId",
                      "sourceBlockId",
                      "sourcePageNumber",
                      "rawLabel",
                      "normalizedLabel"
                    ],
                    "properties": {
                      "referenceId": { "type": "string" },
                      "sourceBlockId": { "type": "string" },
                      "sourcePageNumber": { "type": "integer" },
                      "rawLabel": { "type": "string" },
                      "normalizedLabel": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                },
                "table_rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "rows": { "type": "integer", "minimum": 1 },
                "cols": { "type": "integer", "minimum": 1 },
                "cells": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["row", "col", "rowSpan", "colSpan", "text"],
                    "properties": {
                      "row": { "type": "integer", "minimum": 0 },
                      "col": { "type": "integer", "minimum": 0 },
                      "rowSpan": { "type": "integer", "minimum": 1 },
                      "colSpan": { "type": "integer", "minimum": 1 },
                      "text": { "type": "string" },
                      "bbox": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": { "type": "number" },
                            "minItems": 4,
                            "maxItems": 4
                          },
                          { "type": "null" }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "canonicalFigureNodes": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
